{
  "lastChangelogVersion": "0.85.1",
  "theme": "sunset-rainbow",
  "packages": [
    "npm:pi-llama-cpp",
    "npm:pi-atelier",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-blackhole"
  ],
  "llamaServerUrl": "http://llamacpp:8081",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 4096,
    "modelOverrides": {
      "reasoning": {
        "reserveTokens": 20000,
        "keepRecentTokens": 4096
      },
      "fast": {
        "reserveTokens": 49152,
        "keepRecentTokens": 8192
      },
      "coder": {
        "reserveTokens": 20000,
        "keepRecentTokens": 4096
      }
    }
  },
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "images": {
    "blockImages": true
  },
  "showHardwareCursor": true,
  "transport": "auto",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "always",
  "fullscreenCopyOnSelect": true,
  "hideThinkingBlock": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "doubleEscapeAction": "none",
  "treeFilterMode": "default",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "terminal.hyperlinks": true,
  "terminal.images": "kitty",
  "terminal.trueColor": true,
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "llamacpp/fast"
      }
    }
  }
}
